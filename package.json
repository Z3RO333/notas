{
  "name": "cockpit-distribuicao",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run --workspace apps/web dev",
    "build": "npm run --workspace apps/web build",
    "start": "npm run --workspace apps/web start",
    "lint": "npm run --workspace apps/web lint",
    "test": "npm run --workspace apps/web test",
    "test:coverage": "npm run --workspace apps/web test:coverage",
    "test:e2e": "npm run --workspace apps/web test:e2e",
    "backfill:financeiro-historico": "node scripts/backfill_financeiro_historico.js",
    "backfill:ordens-historico": "node scripts/backfill_ordens_historico.js",
    "reconcile:financeiro-ciclo-atual": "python scripts/reconcile_financeiro_ciclo_atual.py",
    "test:backfill-financeiro-historico": "node --test scripts/__tests__/backfill_financeiro_historico.test.js",
    "test:backfill-ordens-historico": "node --test scripts/__tests__/backfill_ordens_historico.test.js"
  },
  "devDependencies": {
    "supabase": "^2.76.13"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.21"
  }
}
